DATABASE_URL=sqlite+aiosqlite:///./aicte_workflow.db
# To use PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aicte_db
SECRET_KEY=change-this-in-production-use-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
STORAGE_LOCAL_DIR=./storage
SIMULATE_VOICE_CALLS=True
ENVIRONMENT=development
